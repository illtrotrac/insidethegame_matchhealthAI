{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/illtrotrac/insidethegame_matchhealthai/schemas/overlay.schema.json",
  "title": "Overlay",
  "type": "object",
  "required": ["moment_id", "template", "show_at", "duration_s", "priority", "headline", "stats"],
  "additionalProperties": false,
  "properties": {
    "moment_id": {"type": "string"},
    "template": {
      "enum": ["lower_third_stat", "player_tag", "stat_compare", "momentum_chart", "big_chance", "stats_only_fallback"]
    },
    "show_at": {"type": "string", "pattern": "^[0-9]{1,3}:[0-5][0-9]$"},
    "duration_s": {"type": "integer", "minimum": 4, "maximum": 12},
    "priority": {"type": "integer", "minimum": 1, "maximum": 3},
    "headline": {"type": "string", "maxLength": 80},
    "subline": {"type": ["string", "null"], "maxLength": 90},
    "stats": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string"},
          "value": {"type": ["number", "string", "null"]},
          "from": {"type": ["number", "null"]},
          "to": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "focus_player": {"type": ["string", "null"]},
    "mode": {"enum": ["base", "analyst", "casual"], "default": "base"},
    "language": {"type": "string", "default": "en"}
  }
}
