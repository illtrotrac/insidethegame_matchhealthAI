# 1 = run everything locally with deterministic mock agents (no Azure needed)
MATCHHEALTH_MOCK_LLM=1

# Microsoft Foundry (Azure OpenAI-compatible endpoint); auth via DefaultAzureCredential
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/
FOUNDRY_DEPLOYMENT_MINI=gpt-4.1-mini
FOUNDRY_DEPLOYMENT_NANO=gpt-4.1-nano

# Shared state (leave unset to use in-memory)
COSMOS_ENDPOINT=
COSMOS_DATABASE=matchhealth
COSMOS_CONTAINER=moments

# Overlay delivery (leave unset to print to console)
WEBPUBSUB_ENDPOINT=
WEBPUBSUB_HUB=overlays
